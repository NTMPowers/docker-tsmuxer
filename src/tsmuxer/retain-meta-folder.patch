+
+void BlurayHelper::copyMetaDirectory(const std::string& metaDir) const
+{
+    if (metaDir.empty() || !m_isoWriter)
+        return;
+
+    std::string dirPath = metaDir;
+    char sep = getDirSeparator();
+    if (!dirPath.empty() && dirPath.back() != sep && dirPath.back() != '/' && dirPath.back() != '\\') {
+        dirPath += sep;
+    }
+
+    std::vector<std::string> files;
+    if (!findFiles(dirPath, "*", &files, false))
+    {
+        LTRACE(LT_WARN, 2, "Warning: Could not read META directory: " << dirPath);
+        return;
+    }
+
+    for (const auto& fileName : files)
+    {
+        std::string filePath = dirPath + fileName;
+        File inFile;
+        if (!inFile.open(filePath.c_str(), File::ofRead))
+        {
+            LTRACE(LT_WARN, 2, "Warning: Could not open META file: " << filePath);
+            continue;
+        }
+
+        int64_t fileSize = inFile.size();
+        if (fileSize <= 0)
+        {
+            inFile.close();
+            continue;
+        }
+
+        auto buffer = new uint8_t[static_cast<size_t>(fileSize)];
+        if (inFile.read(buffer, static_cast<int32_t>(fileSize)) != fileSize)
+        {
+            LTRACE(LT_WARN, 2, "Warning: Could not read META file: " << filePath);
+            delete[] buffer;
+            inFile.close();
+            continue;
+        }
+        inFile.close();
+
+        std::string isoPath = "BDMV/META/" + fileName;
+        ISOFile* isoFile = m_isoWriter->createFile();
+        if (isoFile->open(isoPath.c_str(), File::ofWrite))
+        {
+            isoFile->write(buffer, static_cast<uint32_t>(fileSize));
+            isoFile->close();
+        }
+        else
+        {
+            LTRACE(LT_WARN, 2, "Warning: Could not create ISO file: " << isoPath);
+        }
+        delete isoFile;
+        delete[] buffer;
+    }
+}
