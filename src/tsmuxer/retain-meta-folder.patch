+void BlurayHelper::copyMetaDirectory(const std::string& metaDir) const
+{
+    LTRACE(LT_INFO, 2, "=== copyMetaDirectory CALLED with: " << metaDir << " ===");
+
+    if (metaDir.empty())
+    {
+        LTRACE(LT_WARN, 2, "copyMetaDirectory: metaDir is empty, skipping.");
+        return;
+    }
+
+    std::string dirPath = metaDir;
+    char sep = getDirSeparator();
+    if (!dirPath.empty() && dirPath.back() != sep && dirPath.back() != '/' && dirPath.back() != '\\') {
+        dirPath += sep;
+    }
+
+    std::vector<std::string> files;
+    findFilesRecursive(dirPath, "*", &files);
+
+    if (files.empty())
+    {
+        LTRACE(LT_WARN, 2, "copyMetaDirectory: No files found in: " << dirPath);
+        return;
+    }
+
+    LTRACE(LT_INFO, 2, "copyMetaDirectory: Found " << files.size() << " files to copy.");
+
+    for (const auto& filePath : files)
+    {
+        File inFile;
+        if (!inFile.open(filePath.c_str(), File::ofRead))
+        {
+            LTRACE(LT_WARN, 2, "copyMetaDirectory: Could not open META file: " << filePath);
+            continue;
+        }
+
+        int64_t fileSize = inFile.size();
+        if (fileSize <= 0)
+        {
+            LTRACE(LT_WARN, 2, "copyMetaDirectory: File size <= 0 for: " << filePath);
+            inFile.close();
+            continue;
+        }
+
+        auto buffer = new uint8_t[static_cast<size_t>(fileSize)];
+        if (inFile.read(buffer, static_cast<int32_t>(fileSize)) != fileSize)
+        {
+            LTRACE(LT_WARN, 2, "copyMetaDirectory: Could not read META file: " << filePath);
+            delete[] buffer;
+            inFile.close();
+            continue;
+        }
+        inFile.close();
+
+        std::string relativePath = filePath;
+        if (filePath.length() >= dirPath.length()) {
+            relativePath = filePath.substr(dirPath.length());
+        }
+        for (char& c : relativePath) {
+            if (c == '\\') c = '/';
+        }
+        std::string isoPath = "BDMV/META/" + relativePath;
+
+        LTRACE(LT_INFO, 2, "copyMetaDirectory: Writing " << filePath << " to " << isoPath);
+
+        if (m_isoWriter)
+        {
+            ISOFile* isoFile = m_isoWriter->createFile();
+            if (isoFile->open(isoPath.c_str(), File::ofWrite))
+            {
+                isoFile->write(buffer, static_cast<uint32_t>(fileSize));
+                isoFile->close();
+            }
+            else
+            {
+                LTRACE(LT_WARN, 2, "copyMetaDirectory: Could not create ISO file: " << isoPath);
+            }
+            delete isoFile;
+        }
+        else
+        {
+            std::string outFilePath = m_dstPath + isoPath;
+            std::string outDir = outFilePath.substr(0, outFilePath.find_last_of("/\\"));
+            createDir(outDir, true);
+            
+            File outFile;
+            if (outFile.open(outFilePath.c_str(), File::ofWrite))
+            {
+                outFile.write(buffer, static_cast<int32_t>(fileSize));
+                outFile.close();
+            }
+            else
+            {
+                LTRACE(LT_WARN, 2, "copyMetaDirectory: Could not create folder file: " << outFilePath);
+            }
+        }
+        delete[] buffer;
+    }
+}
