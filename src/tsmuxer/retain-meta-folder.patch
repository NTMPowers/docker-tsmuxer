+#if !defined(_WIN32)
+#include <dirent.h>
+#include <sys/stat.h>
+static void listFilesPosix(const std::string& path, std::vector<std::string>& out)
+{
+    DIR* dir = opendir(path.c_str());
+    if (!dir)
+        return;
+    struct dirent* entry;
+    while ((entry = readdir(dir)) != nullptr)
+    {
+        std::string name = entry->d_name;
+        if (name == "." || name == "..")
+            continue;
+        std::string fullPath = path;
+        if (fullPath.back() != '/' && fullPath.back() != '\\')
+            fullPath += "/";
+        fullPath += name;
+        struct stat st;
+        if (stat(fullPath.c_str(), &st) == 0)
+        {
+            if (S_ISDIR(st.st_mode))
+                listFilesPosix(fullPath, out);
+            else if (S_ISREG(st.st_mode))
+                out.push_back(fullPath);
+        }
+    }
+    closedir(dir);
+}
+#endif
+
+void BlurayHelper::copyMetaDirectory(const std::string& metaDir) const
+{
+    LTRACE(LT_INFO, 2, "copyMetaDirectory called with: '" << metaDir << "'");
+    if (metaDir.empty() || !m_isoWriter)
+    {
+        LTRACE(LT_WARN, 2, "copyMetaDirectory: metaDir is empty or not ISO mode, skipping.");
+        return;
+    }
+    std::string dirPath = metaDir;
+    const char sep = getDirSeparator();
+    if (!dirPath.empty() && dirPath.back() != sep && dirPath.back() != '/')
+        dirPath += sep;
+    LTRACE(LT_INFO, 2, "copyMetaDirectory: Normalized path: '" << dirPath << "'");
+
+    std::vector<std::string> files;
+#if !defined(_WIN32)
+    listFilesPosix(dirPath, files);
+#else
+    findFilesRecursive(dirPath, "*", &files);
+#endif
+    LTRACE(LT_INFO, 2, "copyMetaDirectory: found " << files.size() << " files");
+
+    if (files.empty())
+    {
+        LTRACE(LT_WARN, 2, "copyMetaDirectory: No files found in: " << dirPath);
+        return;
+    }
+
+    for (const auto& filePath : files)
+    {
+        File inFile;
+        if (!inFile.open(filePath.c_str(), File::ofRead))
+        {
+            LTRACE(LT_WARN, 2, "copyMetaDirectory: Could not open META file: " << filePath);
+            continue;
+        }
+        const int64_t fileSize = inFile.size();
+        if (fileSize <= 0)
+        {
+            inFile.close();
+            continue;
+        }
+        auto buffer = new uint8_t[static_cast<size_t>(fileSize)];
+        if (inFile.read(buffer, static_cast<uint32_t>(fileSize)) != fileSize)
+        {
+            delete[] buffer;
+            inFile.close();
+            continue;
+        }
+        inFile.close();
+        std::string relativePath = filePath;
+        if (filePath.length() >= dirPath.length())
+            relativePath = filePath.substr(dirPath.length());
+        const std::string isoPath = "BDMV/META/DL/" + relativePath;
+        LTRACE(LT_INFO, 2, "copyMetaDirectory: Writing " << filePath << " to " << isoPath);
+        ISOFile* isoFile = m_isoWriter->createFile();
+        if (isoFile->open(isoPath.c_str(), File::ofWrite))
+        {
+            isoFile->write(buffer, static_cast<uint32_t>(fileSize));
+            isoFile->close();
+        }
+        delete isoFile;
+        delete[] buffer;
+    }
+}
